# Exemplo de variáveis de ambiente.
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env nem inclua segredos reais neste arquivo.

# Servidor Backend
PORT=3000
NODE_ENV=development

# Banco de Dados (PostgreSQL)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=dividacontrol
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=divida_control_dev
POSTGRES_DB_TEST=divida_control_test

# Autenticação
JWT_SECRET=troque-este-segredo-jwt-com-ao-menos-32-caracteres
JWT_EXPIRES_IN=1d
